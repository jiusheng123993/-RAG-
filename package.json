{
  "name": "local-project-memory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "bin": {
    "local-project-memory": "dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-electron',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:server && npm run build:renderer && npm run build:electron",
    "build:server": "tsc -p tsconfig.json",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "dev:mcp": "tsx src/index.ts",
    "dev:server": "tsx src/server/index.ts",
    "install:electron": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:ELECTRON_MIRROR='https://npmmirror.com/mirrors/electron/'; $env:force_no_cache='true'; node node_modules/electron/install.js\"",
    "app": "npm run build && node dist/server/launch-app.js",
    "dist": "npm run build && electron-builder",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.0",
    "yaml": "^2.3.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/bcryptjs": "^2.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "latest",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "latest",
    "@types/pg": "^8.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "^10.4.0",
    "clsx": "^2.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "eslint": "latest",
    "lucide-react": "^0.300.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "zustand": "^4.4.0"
  }
}
